{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Delivery": {
    "PollIntervalSeconds": 1,
    "MaxAttempts": 5,
    "BaseRetryDelaySeconds": 2,
    "MaxRetryDelaySeconds": 60
  },
  "AllowedHosts": "*"
}
